# Required — Claude API key for generating responses
ANTHROPIC_API_KEY=sk-ant-...

# Required to register agent on SignalPot marketplace
SIGNALPOT_API_KEY=sp_live_...

# Deployment URL (auto-detected on Vercel)
AGENT_BASE_URL=https://signalpot-agent-sparring-partner.vercel.app

# KeyKeeper integration (optional — falls back to direct env vars)
KEYKEEPER_DISPATCH_URL=https://www.signalpot.dev/api/keykeeper/dispatch
INTERNAL_DISPATCH_KEY=
KEYKEEPER_OWNER_ID=
